# --- Terraform State & Local Files ---
# Never commit state files or local backend configurations containing keys/passwords
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# --- Python & Virtual Environments ---
# Exclude local virtual environments and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environment Folders ---
# Common names for local python virtual environments
venv/
env/
ENV/
.venv/

# --- IDEs & Operating System Files ---
# Exclude local editor settings and OS-specific metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Secrets & Environment Variables ---
# MUST NEVER BE COMMITTED TO VCS
.env
.env.*
!.env.example

# --- Machine Learning Model Artifacts ---
# Auto-generated model binaries
*.pkl
model.pkl